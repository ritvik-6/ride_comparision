# Copy to backend/.env and adjust for your machine.
# Real environment variables take precedence over this file, and .env is gitignored.

APP_NAME=RideCompare API
APP_VERSION=0.1.0

# development | staging | production
ENVIRONMENT=development

# Comma-separated list of exact browser origins allowed to call the API.
# 8081 is the Expo dev server / Expo web; 19006 is the legacy Expo web port.
# A wildcard "*" is rejected at startup, so list every origin explicitly.
# Android and iOS apps are not browsers and are not affected by CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
