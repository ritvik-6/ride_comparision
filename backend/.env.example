# Copy to backend/.env and adjust for your machine.
# Real environment variables take precedence over this file, and .env is gitignored.

APP_NAME=RideCompare API
APP_VERSION=0.1.0

# development | staging | production
ENVIRONMENT=development

# Comma-separated list of exact browser origins allowed to call the API.
# 8081 is the Expo dev server / Expo web; 19006 is the legacy Expo web port.
# A wildcard "*" is rejected at startup, so list every origin explicitly.
# Android and iOS apps are not browsers and are not affected by CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---------------------------------------------------------------------------
# Provider integrations
# ---------------------------------------------------------------------------
# demo | live
#   demo  sample estimates; the default, and the only mode this build serves.
#   live  requires at least one provider below to be enabled AND configured.
# Setting live without valid credentials stops the app at startup.
PROVIDER_MODE=demo

# Per-provider call timeout and the ceiling for one whole comparison, in
# seconds. The budget must be >= the request timeout.
PROVIDER_REQUEST_TIMEOUT_SECONDS=4.0
PROVIDER_TOTAL_BUDGET_SECONDS=6.0

# Credentials for future authorised provider APIs. Leave every value empty to
# keep a provider off — an empty or missing credential is treated as absent.
#
# NEVER commit real credentials. These placeholders exist so the variable names
# are documented; fill them in your local .env (which is gitignored) or, in
# deployment, through your platform's secret store.
UBER_ENABLED=false
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

OLA_ENABLED=false
OLA_CLIENT_ID=
OLA_CLIENT_SECRET=

RAPIDO_ENABLED=false
RAPIDO_CLIENT_ID=
RAPIDO_CLIENT_SECRET=
