# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app bundle,
# so never store API keys, tokens or other secrets in this file.
#
# EXPO_PUBLIC_API_BASE_URL: origin of the RideCompare FastAPI backend, with no
# trailing slash and no path. The app calls POST <base>/api/v1/fares/compare.
#
#   Start the backend:  cd backend && .\.venv\Scripts\Activate.ps1
#                       uvicorn app.main:app --reload --port 8000
#
#   Android emulator:    http://10.0.2.2:8000
#                        (10.0.2.2 is the emulator's alias for your machine's
#                        localhost; "localhost" would point at the emulator.)
#   Physical Android:    http://192.168.x.x:8000
#                        (your machine's LAN IP: use `ipconfig`, then pick the
#                        Wi-Fi/Ethernet IPv4 address. The phone must be on the
#                        same network, and the backend must listen on 0.0.0.0.)
#   Expo web / iOS sim:  http://localhost:8000
#
# Leave it empty and the comparison screen shows a "No server configured"
# message instead of fares — it never falls back to local sample data.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_APP_ENV=development
